generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id                    Int       @id @default(autoincrement())
  rut                   String    @unique
  nombre                String
  apellido              String
  direccion             String
  correoElectronico     String    @unique
  telefono              String
  numeroCaso            Int       @unique
  descripcionCaso       String    @db.Text
  fechaInicioCaso       DateTime
  estadoCaso            EstadoCaso
  descripcionSentencia  String?   @db.Text
  fechaCierreCaso       DateTime?
  createdAt             DateTime  @default(now())
}

enum EstadoCaso {
  ACTIVO
  EN_PROCESO
  CERRADO
}